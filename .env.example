# ============================================================
# Flight Price Alert Bot — Variables de entorno
# ============================================================
# Copiar a .env (local) y/o configurar en Render Dashboard.
# .env NO se commitea (ver .gitignore).
# ============================================================

# --- Runtime -------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info           # debug | info | warn | error
TZ=America/Argentina/Buenos_Aires

# --- Telegram (obligatorio) ---------------------------------
# Token de @BotFather. Chat IDs separados por coma (admins/broadcast).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=       # alternativo: múltiples chat IDs separados por coma
# Polling (true) o webhooks (false). En Render free tier: polling.
TELEGRAM_POLLING=true

# --- Amadeus Self-Service API -------------------------------
# Obtener en https://developers.amadeus.com → My Self-Service Workspace
# Base URL:
#   test.api.amadeus.com   → tier gratuito, datos demo
#   api.amadeus.com        → producción (datos reales, requiere billing)
# Si se dejan vacías, el bot arranca en modo scraper-only.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
AMADEUS_BASE_URL=https://api.amadeus.com
# Requests/segundo permitidos en prod (Amadeus limita por endpoint).
AMADEUS_RATE_LIMIT_RPS=8
# Cuota mensual de seguridad (hard-stop antes de facturar extra).
AMADEUS_MONTHLY_BUDGET=2000
# Tope diario (default = monthly/30).
AMADEUS_DAILY_BUDGET=
# Si true, confirma steals con Amadeus pricing (1 call extra por ofertón).
AMADEUS_CONFIRM_STEALS=false

# --- Scheduler ----------------------------------------------
# Cron para monitoreo de fondo (scraper Google Flights).
MONITOR_SCHEDULE=0 */2 * * *
# Cron para informe diario PDF (21:00 ART por default).
DAILY_REPORT_SCHEDULE=0 21 * * *
REPORT_SCHEDULE=0 21 * * *
# Cron del bot standalone (bot.js).
SCHEDULE=0 */2 * * *
AUTO_MONITOR=true

# --- Providers / caché --------------------------------------
# TTL cache respuestas Amadeus (ms). 6h es razonable.
CACHE_TTL_MS=21600000
# TTL cache Google Flights (ms). 1h.
CACHE_TTL_GF_MS=3600000

# --- Scrapers -----------------------------------------------
# Kiwi API (fallback alternativo).
KIWI_API_KEY=
# SerpAPI (Google Flights via API).
SERPAPI_KEY=
SERPAPI_DAILY_BUDGET=8
SERPAPI_CACHE_TTL_HOURS=12
# Debug mode para Google Flights API.
GOOGLE_FLIGHTS_DEBUG=false
# Timezone para monitoreo.
MONITOR_TIMEZONE=America/Argentina/Buenos_Aires
# Fechas default para búsquedas manuales.
SEARCH_DATE_DEFAULT_DEPARTURE=
SEARCH_DATE_DEFAULT_RETURN=
# Timeout hard para scraper (ms).
SCRAPER_TIMEOUT_MS=30000

# --- Puppeteer (fallback scraper) --------------------------
# Dejar vacío en local; en Docker/Render usa el binario del sistema.
PUPPETEER_EXECUTABLE_PATH=
# Modo headless (true) o visible (false).
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT=25000
PUPPETEER_RETRIES=1
# Deshabilitar Puppeteer (ej: en entornos sin Chrome).
DISABLE_PUPPETEER=false

# --- Base de datos ------------------------------------------
# MongoDB Atlas (recomendado para Render — persistencia real).
# Crear cluster gratis en https://www.mongodb.com/atlas
# Local development: mongodb://localhost:27017/flightbot
MONGODB_URI=mongodb://localhost:27017/flightbot
# SQLite legacy (solo fallback si MONGODB_URI no está configurado).
SQLITE_PATH=./data/flights.db