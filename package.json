{
  "name": "flight-deal-finder",
  "version": "7.0.0",
  "description": "Bot Telegram de ofertas de vuelos AR↔EU (Amadeus + Google Flights híbrido) con alertas全年 monitoring.",
  "main": "src/app.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/app.js",
    "start:legacy": "node server/app.js",
    "build": "npx playwright install --with-deps chromium",
    "postinstall": "npx playwright install chromium",
    "bot": "node src/app.js",
    "server": "node src/app.js",
    "dev": "node src/app.js",
    "test": "jest --detectOpenHandles",
    "test:scraper": "jest server/scrapers --testTimeout=30000",
    "test:api": "jest server/routes --testTimeout=10000",
    "test:db": "jest server/database --testTimeout=10000",
    "test:regression": "jest tests/ --testTimeout=10000",
    "backfill:alert-level": "node scripts/backfill-alert-level.js",
    "add:italy-june-alerts": "node scripts/add-italy-june-alerts.js",
    "alerts:italia-oct-nov": "node scripts/add-italy-june-alerts.js --threshold 480 --origins EZE,COR --dests VCE,FCO --dates 2026-10-30,2026-10-31,2026-11-01,2026-11-02,2026-11-03,2026-11-04",
    "cleanup:poisoned-notifs": "node scripts/cleanup-poisoned-notifs.js",
    "canary:google-flights": "node scripts/canary-google-flights.js"
  },
  "keywords": [
    "flights",
    "deals",
    "price-tracking",
    "telegram",
    "google-flights",
    "argentina",
    "usa"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.7",
    "bottleneck": "^2.19.5",
    "cheerio": "^1.0.0-rc.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "mongoose": "^9.5.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "pdfkit": "^0.17.2",
    "playwright": "^1.52.0",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  }
}
